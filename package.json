{
  "name": "thuong-ielts",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:web": "npm run build --workspace=apps/web",
    "build:admin": "npm run build --workspace=apps/admin",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:admin": "npm run lint --workspace=apps/admin",
    "migrate": "tsx scripts/migrate.ts",
    "check:reading": "tsx scripts/validate-reading.ts",
    "check:listening": "tsx scripts/validate-listening.ts",
    "check:coverage": "tsx scripts/coverage.ts",
    "import:testimonial-images": "tsx --env-file=apps/web/.env.local scripts/import-testimonial-images.ts",
    "close:expired": "tsx scripts/close-expired-attempts.ts",
    "clean:guests": "tsx scripts/clean-guests.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/pg": "^8.15.5",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.2.3",
    "pg": "^8.22.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
