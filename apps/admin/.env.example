# Postgres connection (same RDS instance the web app uses)
PGHOST="your-db-host.rds.amazonaws.com"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="your-password"
PGDATABASE="postgres"

# Admin auth (single admin). Generate ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('your-new-password', 10))"
# Note: escape every literal $ in the hash as \$ — Next.js treats $ in .env
# files as variable interpolation.
ADMIN_USERNAME="your-username"
ADMIN_PASSWORD_HASH="\$2b\$10\$..."
ADMIN_SESSION_SECRET="a long random hex string, e.g. via: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
