# Postgres — nguồn dữ liệu duy nhất của trang: học viên, cảm nhận, và toàn bộ đề thi.
# Chép file này thành .env.local rồi điền thông tin thật. .env.local đã được gitignore.
PGHOST="your-db-host.rds.amazonaws.com"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="your-password"
PGDATABASE="postgres"

# ── Đăng nhập học viên ────────────────────────────────────────────────
# Bắt buộc: khoá ký JWT phiên đăng nhập. Sinh bằng `openssl rand -base64 32`.
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"

# Google OAuth — console.cloud.google.com > Credentials > OAuth client ID.
# Redirect URI phải khai đúng: https://<domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook Login — developers.facebook.com > App > Facebook Login > Settings.
# Redirect URI: https://<domain>/api/auth/callback/facebook
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Zalo OA — gửi mã OTP qua ZNS. Lấy ở developers.zalo.me.
# Mẫu tin OTP phải được Zalo duyệt trước mới gửi được.
# Để trống ở máy dev: mã sẽ được in ra console server thay vì gửi thật.
ZALO_OA_APP_ID=""
ZALO_OA_SECRET_KEY=""
ZALO_ZNS_TEMPLATE_ID=""
# Refresh token lần đầu lấy tay; sau đó hệ thống tự làm mới và cất vào bảng
# site_content (Zalo đổi refresh token sau mỗi lần làm mới, dùng lại là hỏng).
ZALO_OA_REFRESH_TOKEN=""

# Tuỳ chọn: khoá riêng để băm mã OTP. Bỏ trống thì dùng AUTH_SECRET.
OTP_HASH_SECRET=""

# Địa chỉ gốc của trang, dùng để dựng URL callback OAuth.
# Bắt buộc khai: dev server bind 0.0.0.0 nên nếu để next-auth tự suy từ Host
# header thì callback thành http://0.0.0.0:2000/... và Google từ chối.
# Dev: http://localhost:2000 — Production: https://thuong-ielts.onrender.com
AUTH_URL="http://localhost:2000"
